<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SandstormModLauncher</AssemblyName>
    <RootNamespace>SandstormModLauncher</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.6.0</Version>
    <FileVersion>1.6.0.0</FileVersion>
    <Product>Sandstorm Mod Launcher</Product>
    <AssemblyTitle>Sandstorm Mod Launcher</AssemblyTitle>
    <Description>Local play launcher with mods and mutators for Insurgency: Sandstorm</Description>
    <Authors>goranbalsic</Authors>
    <Company>goranbalsic</Company>
    <Copyright>Copyright (c) 2026 goranbalsic. All rights reserved (source available). Not affiliated with New World Interactive or Focus Entertainment.</Copyright>
    <RepositoryUrl>https://github.com/goranbalsic/insurgency-sandstorm-mod-launcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>embedded</DebugType>
    <Nullable>disable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Release builds (-p:OfficialBuild=true) install updates themselves; an exe built from source only reports them. -->
  <PropertyGroup Condition="'$(OfficialBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);OFFICIAL_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework reference assemblies, so the project builds without Visual Studio installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Oswald.ttf" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <EmbeddedResource Include="Resources\GameRules.json" />
  </ItemGroup>

</Project>
