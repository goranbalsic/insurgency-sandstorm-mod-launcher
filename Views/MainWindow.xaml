<Window x:Class="SandstormModLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:SandstormModLauncher.Views.Pages"
        Title="Sandstorm Mod Launcher" Width="1360" Height="860" MinWidth="1120" MinHeight="700"
        Background="{StaticResource Bg1}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Body}" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" Icon="/Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LaunchCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="SummaryChip" TargetType="Border">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0,0,12,0" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="OverlayCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{StaticResource Bg2}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.55" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="rootBorder" BorderBrush="{StaticResource Bg4}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================================================== header -->
            <Border Grid.Row="0" Background="{StaticResource Bg0}" BorderBrush="{StaticResource Bg4}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Sandstorm Mod Launcher" FontFamily="{StaticResource Display}" FontSize="14" />
                        </StackPanel>
                        <Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="16,0" />
                        <TextBlock Text="Profile" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Width="230" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" WindowChrome.IsHitTestVisibleInChrome="True"
                                  IsEnabled="{Binding CanSwitchProfile}" ToolTip="A profile keeps a whole setup: map, bots, rules and mutators" />
                        <Button x:Name="profileMenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="6,0,0,0" Click="ProfileMenu_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="New, duplicate, rename or delete profiles">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New profile..." Command="{Binding NewProfileCommand}" />
                                    <MenuItem Header="Duplicate this profile..." Command="{Binding DuplicateProfileCommand}" />
                                    <MenuItem Header="Rename..." Command="{Binding RenameProfileCommand}" />
                                    <MenuItem Header="Delete this profile" Command="{Binding DeleteProfileCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Border Height="28" CornerRadius="2" Padding="10,0" BorderThickness="1" MaxWidth="440"
                                Background="{Binding GameStatusKind, Converter={StaticResource Status}, ConverterParameter=bg}"
                                BorderBrush="{Binding GameStatusKind, Converter={StaticResource Status}, ConverterParameter=border}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding GameStatusKind, Converter={StaticResource Status}, ConverterParameter=dot}" />
                                <TextBlock Text="{Binding GameStatus}" FontSize="12.5" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding GameStatusKind, Converter={StaticResource Status}}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Margin="8,0,0,0" Command="{Binding StartGameCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Start the game now (your rules are written first), without loading a match yet"
                                Visibility="{Binding GameStatusKind, Converter={StaticResource Vis}, ConverterParameter=Off}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0" />
                                <TextBlock Text="Start game" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="32" Padding="12,0" Margin="8,0,0,0" Command="{Binding StopGameCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close the game"
                                Visibility="{Binding GameStatusKind, Converter={StaticResource VisNot}, ConverterParameter=Off}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0" />
                                <TextBlock Text="Close game" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="8,0,0,0" Content="&#xE897;" FontSize="13" Command="{Binding HelpCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="How it works" BorderBrush="{StaticResource Line}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button x:Name="maxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource Bg4}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                            <Button Style="{StaticResource LinkButton}" Content="Update ready" FontSize="10.5" HorizontalAlignment="Center" Margin="0,0,0,4"
                                    Command="{Binding RestartToUpdateCommand}" ToolTip="{Binding UpdateReadyTip}"
                                    Visibility="{Binding UpdateReady, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource NavButton}" Content="Play" Tag="&#xE768;" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Play}" ToolTip="Map, squad, rules, official playlists and live control of the match" />
                            <RadioButton Style="{StaticResource NavButton}" Content="Mods" Tag="&#xEA86;" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Mods}" ToolTip="Mutators (official and from mods) and installed mods" />
                            <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="&#xE713;" IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Settings}" ToolTip="Game folder, console key, launch options" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <p:PlayPage Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=Play}" />
                    <p:ModsPage Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=Mods}" />
                    <p:SettingsPage Visibility="{Binding Page, Converter={StaticResource Vis}, ConverterParameter=Settings}" />
                </Grid>
            </Grid>

            <!-- ======================================================== launch bar -->
            <Border Grid.Row="2" Height="62" Background="{StaticResource Bg0}" BorderBrush="{StaticResource Bg4}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" ClipToBounds="True">
                            <Border Style="{StaticResource SummaryChip}">
                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                    <Run Text="{Binding MapSummary, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ModeSummary, Mode=OneWay}" Foreground="{StaticResource TextDim}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource SummaryChip}">
                                <TextBlock Text="{Binding SquadSummary}" VerticalAlignment="Center" FontSize="12" />
                            </Border>
                            <Border Style="{StaticResource SummaryChip}">
                                <TextBlock Text="{Binding MutatorSummary}" VerticalAlignment="Center" FontSize="12" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Style="{StaticResource SummaryChip}" BorderThickness="0">
                                <TextBlock Text="{Binding RulesSummary}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource AccentSoftFg}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding PlanCommand}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis"
                                   Margin="0,7,0,0" ToolTip="{Binding PlanCommand}" Visibility="{Binding PlanError, Converter={StaticResource VisNot}}" />
                        <TextBlock Text="{Binding PlanError}" FontSize="12" Foreground="{StaticResource Warn}" Margin="0,7,0,0" Visibility="{Binding PlanError, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Height="34" Margin="0,0,12,0" Command="{Binding CopyCommandCommand}"
                            ToolTip="Copy the console command, if you ever want to paste it yourself">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Copy command" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource LaunchButton}" Height="38" MinWidth="200" Command="{Binding LaunchCommand}" ToolTip="{Binding LaunchSubtitle}" AutomationProperties.Name="Launch">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0,0 L 10,6 L 0,12 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding LaunchTitle}" FontFamily="{StaticResource Display}" FontSize="14.5" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ======================================================== launch progress -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource Overlay}" Visibility="{Binding LaunchOverlayOpen, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource OverlayCard}" Width="620" Padding="28,24">
                    <StackPanel>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Kicker}">
                                    <Setter Property="Text" Value="LAUNCHING" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LaunchSucceeded}" Value="True">
                                            <Setter Property="Text" Value="READY" />
                                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LaunchFailed}" Value="True">
                                            <Setter Property="Text" Value="LAUNCH STOPPED" />
                                            <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding LaunchHeadline}" Style="{StaticResource H1}" FontSize="18" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Mute}" Margin="0,4,0,0">
                            <Run Text="{Binding SquadSummary, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding MutatorSummary, Mode=OneWay}" />
                        </TextBlock>
                        <ProgressBar Value="{Binding LaunchProgress, Mode=OneWay}" Maximum="1" Margin="0,16,0,10" />
                        <ItemsControl ItemsSource="{Binding LaunchSteps}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding State, Converter={StaticResource StepIcon}}" Foreground="{Binding State, Converter={StaticResource StepBrush}}"
                                                   FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="title" Text="{Binding Title}" FontSize="13.5" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Mute}" Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Pending">
                                            <Setter TargetName="title" Property="Foreground" Value="{StaticResource TextFaint}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Active">
                                            <Setter TargetName="title" Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter TargetName="title" Property="Foreground" Value="{StaticResource BadFg}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{StaticResource InfoBg}" BorderBrush="{StaticResource InfoBorder}" BorderThickness="1" CornerRadius="2" Padding="12,8" Margin="0,12,0,0"
                                Visibility="{Binding LaunchRunning, Converter={StaticResource Vis}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource InfoFg}"
                                       Text="Keep your hands off the keyboard for a few seconds while the match is sent to the game." />
                        </Border>
                        <Border CornerRadius="2" Padding="12,9" Margin="0,12,0,0" BorderThickness="1" Visibility="{Binding LaunchResult, Converter={StaticResource Vis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BadBg}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BadBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LaunchSucceeded}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource GoodBg}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource GoodBorder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding LaunchResult}" TextWrapping="Wrap" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BadFg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LaunchSucceeded}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GoodFg}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <ItemsControl ItemsSource="{Binding LaunchWarnings}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextDim}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="Cancel" Command="{Binding CancelLaunchCommand}" Visibility="{Binding LaunchRunning, Converter={StaticResource Vis}}" />
                            <Button Content="Settings" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="Settings" Click="CloseLaunch_Click"
                                    Visibility="{Binding LaunchFailed, Converter={StaticResource Vis}}" />
                            <Button Content="Try again" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Command="{Binding RetryLaunchCommand}"
                                    Visibility="{Binding LaunchFailed, Converter={StaticResource Vis}}" />
                            <Button Content="Close" Margin="8,0,0,0" Command="{Binding CloseLaunchCommand}" Visibility="{Binding LaunchRunning, Converter={StaticResource VisNot}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== custom map editor -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource Overlay}" Visibility="{Binding MapEditorOpen, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource OverlayCard}" Width="520" Padding="26,22">
                    <StackPanel>
                        <TextBlock Text="Custom map" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Add a map by name" Style="{StaticResource H1}" FontSize="18" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Mute}" Margin="0,4,0,0"
                                   Text="Mod maps are found automatically. Use this for maps the launcher cannot read, or special scenarios. The mod author's page usually lists the level and scenario names." />
                        <TextBlock Text="Name in the launcher" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="0,14,0,5" />
                        <TextBox Text="{Binding EditMapLabel, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Kandagal night raid" />
                        <TextBlock Text="Level" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding EditMapLevel, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" Tag="e.g. Kandagal or /Kandagal/Maps/Kandagal" />
                        <TextBlock Text="Scenario" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="0,12,0,5" />
                        <TextBox Text="{Binding EditMapScenario, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" Tag="e.g. Scenario_Kandagal_Checkpoint_Security" />
                        <TextBlock Text="Game mode (for bot and rule settings)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="0,12,0,5" />
                        <ComboBox ItemsSource="{Binding EditMapModeChoices}" SelectedItem="{Binding EditMapMode}" />
                        <TextBlock Style="{StaticResource Mute}" Margin="0,4,0,0" Text="Leave empty to guess it from the scenario name." />
                        <DockPanel Margin="0,20,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCustomMapCommand}"
                                    Visibility="{Binding MapEditorIsNew, Converter={StaticResource VisNot}}" />
                            <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Command="{Binding SaveCustomMapCommand}" />
                            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCustomMapCommand}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== dialog -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource Overlay}" Visibility="{Binding DialogOpen, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource OverlayCard}" Width="500" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DialogMessage}" Style="{StaticResource Dim}" FontSize="13" Margin="0,10,0,0" LineHeight="19" />
                        <TextBox x:Name="dialogInput" Text="{Binding DialogInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,0"
                                 Visibility="{Binding DialogHasInput, Converter={StaticResource Vis}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="{Binding DialogTertiary}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding DialogCommand}" CommandParameter="{Binding DialogTertiary}"
                                    Visibility="{Binding DialogTertiary, Converter={StaticResource Vis}}" />
                            <Button Content="{Binding DialogSecondary}" Margin="0,0,8,0" Command="{Binding DialogCommand}" CommandParameter="{Binding DialogSecondary}"
                                    Visibility="{Binding DialogSecondary, Converter={StaticResource Vis}}" />
                            <Button x:Name="dialogPrimary" Content="{Binding DialogPrimary}" Style="{StaticResource AccentButton}" MinWidth="80" Command="{Binding DialogCommand}" CommandParameter="{Binding DialogPrimary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== loading -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource Bg1}" Visibility="{Binding Loading, Converter={StaticResource Vis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                    <Image Source="/Assets/logo.png" Width="60" Height="60" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Sandstorm Mod Launcher" FontFamily="{StaticResource Display}" FontSize="22" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding LoadingText}" Style="{StaticResource Dim}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,18" />
                    <Border Height="4" CornerRadius="2" Background="{StaticResource Bg4}" ClipToBounds="True">
                        <Border Width="110" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Accent}">
                            <Border.RenderTransform>
                                <TranslateTransform X="-110" />
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Loading}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="busy">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-110" To="380" Duration="0:0:1.3" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="busy" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ======================================================== toast -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="84,0,0,18" Background="{StaticResource Bg4}" BorderBrush="{StaticResource LineStrong}"
                    BorderThickness="1" CornerRadius="2" Padding="16,10" IsHitTestVisible="False" MaxWidth="720"
                    Visibility="{Binding Toast, Converter={StaticResource Vis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Toast}" FontSize="13" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
