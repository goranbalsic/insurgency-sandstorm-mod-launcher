<UserControl x:Class="SandstormModLauncher.Views.Pages.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="SwitchRow" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="20,18,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Host your match for other players" Style="{StaticResource Kicker}" />
                <TextBlock Text="Dedicated server" Style="{StaticResource H1}" FontSize="20" Margin="0,2,0,0" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- server -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="2" Padding="9,2" BorderThickness="1" MaxWidth="330"
                                        Background="{Binding ServerStatusKind, Converter={StaticResource Status}, ConverterParameter=bg}"
                                        BorderBrush="{Binding ServerStatusKind, Converter={StaticResource Status}, ConverterParameter=border}">
                                    <TextBlock Text="{Binding ServerStatus}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{Binding ServerStatusKind, Converter={StaticResource Status}}" />
                                </Border>
                                <TextBlock Text="Server" Style="{StaticResource H2}" />
                            </DockPanel>
                            <Border Style="{StaticResource SegmentHost}" Margin="0,12,0,0">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" Content="On this PC" IsChecked="{Binding ServerLocal}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="On another PC (RCON)" IsChecked="{Binding ServerRemote}" />
                                </UniformGrid>
                            </Border>

                            <StackPanel Visibility="{Binding ServerRemote, Converter={StaticResource VisNot}}">
                                <TextBlock Style="{StaticResource Label}">
                                    <Run Text="Server folder" /><Run Text="   " /><Run Text="{Binding ServerBuild, Mode=OneWay}" FontWeight="Normal" />
                                </TextBlock>
                                <Border Style="{StaticResource Well}" Padding="10,7">
                                    <TextBlock Text="{Binding ServerDir}" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Change folder..." Margin="0,0,8,6" Command="{Binding ChangeServerDirCommand}" />
                                    <Button Content="Find automatically" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding FindServerDirCommand}" />
                                    <Button Content="Open folder" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenServerPathCommand}" CommandParameter="Folder"
                                            Visibility="{Binding ServerFound, Converter={StaticResource Vis}}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Mute}" Visibility="{Binding ServerFound, Converter={StaticResource VisNot}}"
                                           Text="Install the free &quot;Insurgency: Sandstorm Dedicated Server&quot; from your Steam library (Tools), or with SteamCMD (app 581330), then press Find automatically." />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource AccentButton}" Margin="0,0,8,6" Command="{Binding StartServerCommand}" ToolTip="Writes the server's settings and starts it with your match from Play">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0" />
                                            <TextBlock Text="Start server" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Stop" Margin="0,0,8,6" Command="{Binding StopServerCommand}" />
                                    <Button Content="Restart with this match" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding RestartServerCommand}"
                                            ToolTip="Stops the server and starts it again with the match and settings on this page" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ServerProgress}" Style="{StaticResource Mute}" Visibility="{Binding ServerProgress, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding ServerPlanError}" FontSize="12.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding ServerPlanError, Converter={StaticResource Vis}}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ServerRemote, Converter={StaticResource Vis}}">
                                <TextBlock Text="Address of the other PC" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding ServerRemoteHost, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Tag="e.g. 203.0.113.5 or myserver.example.com" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="RCON port" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding ServerRemotePortText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RCON password" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding ServerRemotePassword, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Check connection" Margin="0,0,8,6" Command="{Binding CheckServerConnectionCommand}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Mute}"
                                           Text="Over RCON you control the players, the chat, the map and the rules. Starting and stopping the server and its files need the server on this PC." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- settings -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding ServerRemote, Converter={StaticResource VisNot}}">
                        <StackPanel>
                            <TextBlock Text="Server settings" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,0" Text="Used the next time the server starts." />
                            <TextBlock Text="Name in the server browser" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ServerName, UpdateSourceTrigger=LostFocus}" Tag="e.g. Friday night co-op" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Max players" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding ServerMaxPlayersText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Join password (optional)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding ServerJoinPassword, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Tag="empty = anyone can join" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Game port (UDP)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding ServerPortText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Query port (UDP)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding ServerQueryPortText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,6,0,0" Text="Players on the internet need both ports open in your firewall and forwarded by your router." />
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding ServerShowLog}" Margin="0,12,0,6">
                                <StackPanel>
                                    <TextBlock Text="Show the server's log window" FontSize="13.5" />
                                    <TextBlock Text="The server's own window with its live log (-log)." Style="{StaticResource Mute}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding ServerCheats}">
                                <StackPanel>
                                    <TextBlock Text="Allow cheats" FontSize="13.5" />
                                    <TextBlock Text="For testing: cheat commands work on this server, and players earn no XP (-EnableCheats)." Style="{StaticResource Mute}" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="Steam server token (GSLT, optional)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ServerGslt, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Tag="from steamcommunity.com/dev/managegameservers, app id 581320" />
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding ServerGameStats}" Margin="0,10,0,6">
                                <StackPanel>
                                    <TextBlock Text="Game stats" FontSize="13.5" />
                                    <TextBlock Text="Players earn XP and stats here (needs the token and no join password)." Style="{StaticResource Mute}" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="Extra command-line options" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ServerExtraArgs, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Tag="added to the end of the server's command line" />
                        </StackPanel>
                    </Border>

                    <!-- rcon -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding ServerRemote, Converter={StaticResource VisNot}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mute}" VerticalAlignment="Bottom" FontFamily="{StaticResource Mono}" Text="{Binding ServerRconAddress}" />
                                <TextBlock Text="Remote control (RCON)" Style="{StaticResource H2}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,0"
                                       Text="The launcher controls the server through its RCON, set up in the server's Game.ini with a random password. Other RCON tools work with the same port and password." />
                            <DockPanel Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Left" Width="120">
                                    <TextBlock Text="RCON port (TCP)" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding ServerRconPortText, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" />
                                </StackPanel>
                                <WrapPanel VerticalAlignment="Bottom" Margin="12,0,0,0">
                                    <Button Content="Copy password" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding CopyServerRconPasswordCommand}" />
                                    <Button Content="New password" Style="{StaticResource GhostButton}" Command="{Binding NewServerRconPasswordCommand}" />
                                </WrapPanel>
                            </DockPanel>
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding ServerRconFromNetwork}" Margin="0,12,0,6">
                                <StackPanel>
                                    <TextBlock Text="Allow RCON from other PCs" FontSize="13.5" />
                                    <TextBlock Text="Off: only this PC can connect. On: every network card listens; your firewall must let the port through, and 5 wrong passwords lock an address out for 30 minutes." Style="{StaticResource Mute}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- admins -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding ServerRemote, Converter={StaticResource VisNot}}">
                        <StackPanel>
                            <TextBlock Text="Admins" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,8"
                                       Text="Steam IDs (the 17-digit number starting with 7656119), one per line. Admins open the admin menu in the game (Keypad -) to kick, ban and change the map." />
                            <TextBox Style="{StaticResource CodeBox}" Height="90" Text="{Binding ServerAdmins, UpdateSourceTrigger=LostFocus}" Tag="76561198000000000" />
                        </StackPanel>
                    </Border>

                    <!-- mods -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding ServerRemote, Converter={StaticResource VisNot}}">
                        <StackPanel>
                            <TextBlock Text="Mods" Style="{StaticResource H2}" />
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding ServerModsEnabled}" Margin="0,8,0,6">
                                <StackPanel>
                                    <TextBlock Text="Load mods on the server" FontSize="13.5" />
                                    <TextBlock Text="The server downloads them from mod.io when it starts (-Mods), then loads your match again; players get them when they join." Style="{StaticResource Mute}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="mod.io mod ids, one per line" Style="{StaticResource Label}" />
                            <TextBox Style="{StaticResource CodeBox}" Height="80" Text="{Binding ServerModIds, UpdateSourceTrigger=LostFocus}" Tag="e.g. 1457355" />
                            <DockPanel Margin="0,6,0,0" Visibility="{Binding ServerMatchMods, Converter={StaticResource Vis}}">
                                <Button DockPanel.Dock="Right" Content="Add them" Style="{StaticResource GhostButton}" Command="{Binding AddMatchModsCommand}" />
                                <TextBlock Text="{Binding ServerMatchMods}" Style="{StaticResource Mute}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="mod.io access token" Style="{StaticResource Label}" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,0,0,6"
                                       Text="The server needs your own mod.io token to download mods: on mod.io, your account > API access > OAuth 2 > create a token with read access. It is saved only in the server's Engine.ini." />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Save to Engine.ini" Margin="8,0,0,0" Command="{Binding SaveModioTokenCommand}" />
                                <TextBox Text="{Binding ModioTokenInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" Tag="paste the token here" />
                            </DockPanel>
                            <TextBlock Text="{Binding ModioTokenStatus}" Style="{StaticResource Mute}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- match -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Change it in Play" Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="Play" />
                                <TextBlock Text="Match" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,8" Text="The server starts with your match from Play: map, scenario, lighting, rules, bots and mutators." />
                            <Border Style="{StaticResource Well}" Padding="10,8">
                                <TextBlock Text="{Binding ServerMatchSummary}" FontSize="13" TextWrapping="Wrap" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding ServerWarnings}" Margin="0,6,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextDim}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- map cycle -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding ServerRemote, Converter={StaticResource VisNot}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mute}" VerticalAlignment="Bottom">
                                    <Run Text="{Binding MapCycleCount, Mode=OneWay}" /><Run Text=" scenarios" />
                                </TextBlock>
                                <TextBlock Text="Map cycle" Style="{StaticResource H2}" />
                            </DockPanel>
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding ServerUseMapCycle}" Margin="0,8,0,6">
                                <StackPanel>
                                    <TextBlock Text="Use a map cycle" FontSize="13.5" />
                                    <TextBlock Text="The server plays these one after another. Off: it goes through the game's versus scenarios." Style="{StaticResource Mute}" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="File" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource Well}" Padding="10,7">
                                <TextBlock Text="{Binding MapCycleFile}" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Use another file..." Margin="0,0,8,6" Command="{Binding ChooseMapCycleFileCommand}" ToolTip="Any MapCycle.txt; the server gets a copy in its Config\Server folder when it starts" />
                                <Button Content="Back to MapCycle.txt" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding DefaultMapCycleFileCommand}"
                                        Visibility="{Binding MapCycleIsDefault, Converter={StaticResource VisNot}}" />
                                <Button Content="Open in editor" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenServerPathCommand}" CommandParameter="MapCycle" />
                            </WrapPanel>
                            <Button HorizontalAlignment="Left" Margin="0,6,0,8" Command="{Binding AddMatchToCycleCommand}" ToolTip="Adds the scenario, lighting and mode picked in Play">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0" />
                                    <TextBlock Text="Add the Play match" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Mute}" Visibility="{Binding MapCycleItems.Count, Converter={StaticResource VisNot}}"
                                       Text="No scenarios yet. Set up a match in Play and press Add the Play match." />
                            <ItemsControl ItemsSource="{Binding MapCycleItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE708;" ToolTip="Day or night"
                                                            Command="{Binding DataContext.ToggleCycleLightingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsEntry, Converter={StaticResource Vis}}" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Earlier"
                                                            Command="{Binding DataContext.MoveCycleItemUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Later"
                                                            Command="{Binding DataContext.MoveCycleItemDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                                            Command="{Binding DataContext.RemoveCycleItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="26" Text="{Binding Number}" Foreground="{StaticResource TextFaint}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsEntry, Converter={StaticResource Vis}}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Mute}" FontSize="11.5" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- live -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}" Padding="10,4" Command="{Binding RefreshPlayersCommand}" />
                                <TextBlock Text="Players" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,8" Text="Live control of the running server over RCON." />
                            <TextBlock Style="{StaticResource Mute}" Visibility="{Binding ServerPlayers.Count, Converter={StaticResource VisNot}}" Text="No players on the server (or it is not running)." />
                            <ItemsControl ItemsSource="{Binding ServerPlayers}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="Kick" Style="{StaticResource GhostButton}" Padding="10,3" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.KickPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Content="Ban" Style="{StaticResource DangerButton}" Padding="10,3" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.BanPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Score, Mode=OneWay}" Foreground="{StaticResource TextFaint}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Chat message to everyone" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Send" Margin="8,0,0,0" Command="{Binding SayCommand}" />
                                <TextBox Text="{Binding SayText, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Map change in 2 minutes" />
                            </DockPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Load the Play match now" Margin="0,0,8,6" Command="{Binding TravelServerCommand}" ToolTip="Changes the running server to the match set up in Play" />
                                <Button Content="Restart round" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding RestartServerRoundCommand}" CommandParameter="0" />
                                <Button Content="Restart, swap teams" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding RestartServerRoundCommand}" CommandParameter="1" />
                            </WrapPanel>
                            <TextBlock Text="RCON command" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Send" Margin="8,0,0,0" Command="{Binding SendServerCommandCommand}" />
                                <TextBox Text="{Binding ServerCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" Tag="e.g. listgamemodeproperties bBots" />
                            </DockPanel>
                            <Border Style="{StaticResource Well}" Margin="0,10,0,0" Padding="10,8" MinHeight="60">
                                <TextBlock Text="{Binding ServerOutput}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- command line -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding ServerRemote, Converter={StaticResource VisNot}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource GhostButton}" Padding="10,4" Command="{Binding CopyServerCommandLineCommand}" />
                                <TextBlock Text="Command line" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,8"
                                       Text="What the launcher runs. Copy it to start the server your own way, e.g. from a .bat file or a server host's panel (its files are written when you press Start here)." />
                            <TextBox Style="{StaticResource CodeBox}" IsReadOnly="True" Text="{Binding ServerCommandLine, Mode=OneWay}" TextWrapping="Wrap" Height="Auto" MinHeight="60" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Game.ini folder" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenServerPathCommand}" CommandParameter="Config" />
                                <Button Content="Admins and map cycle folder" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenServerPathCommand}" CommandParameter="Lists" />
                                <Button Content="Server logs" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenServerPathCommand}" CommandParameter="Logs" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
