<UserControl x:Class="SandstormModLauncher.Views.Pages.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- value editors, picked by the rule's type -->
        <DataTemplate x:Key="BoolEditor">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Bool}" HorizontalAlignment="Left" />
        </DataTemplate>
        <DataTemplate x:Key="NumberEditor">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="{Binding Min, Mode=OneWay}" Maximum="{Binding Max, Mode=OneWay}" Value="{Binding Number, Mode=OneWay}" SmallChange="{Binding Step, Mode=OneWay}"
                        LargeChange="{Binding Step, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="RuleSlider_ValueChanged" />
                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" FontSize="12.5" Padding="6,4"
                         HorizontalContentAlignment="Right" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="EnumEditor">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding EnumValue}" />
        </DataTemplate>
        <DataTemplate x:Key="TextEditor">
            <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" FontSize="12.5" Padding="6,4" />
        </DataTemplate>
        <Style x:Key="EditorHost" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ContentTemplate" Value="{StaticResource TextEditor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBool}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource BoolEditor}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsNumber}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource NumberEditor}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsEnum}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource EnumEditor}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="MATCH RULES" Style="{StaticResource Kicker}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding RulesModeTitle}" Style="{StaticResource H1}" FontSize="28" />
                    <TextBlock Text="every setting the game exposes" Style="{StaticResource Mute}" FontSize="13" VerticalAlignment="Bottom" Margin="12,0,0,6" />
                    <Border Style="{StaticResource Badge}" Background="{StaticResource GoodBg}" Margin="12,0,0,6" VerticalAlignment="Bottom"
                            Visibility="{Binding RulesModeIsPlayed, Converter={StaticResource Vis}}">
                        <TextBlock Text="SELECTED ON PLAY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource GoodFg}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Grid Width="230">
                    <TextBox Text="{Binding RuleSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search every setting" Padding="30,6,8,6" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <Button Content="Save as preset" Margin="8,0,0,0" Command="{Binding SaveRulesPresetCommand}" ToolTip="Save all your rule changes (every mode) and mutators as a preset" />
                <Button Content="Reset mode" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding ResetModeCommand}" />
                <Button Content="Reset all" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding ResetAllRulesCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- game mode tabs -->
        <ListBox Grid.Row="1" Style="{StaticResource PlainList}" Margin="0,14,0,12" ItemsSource="{Binding RuleModes}" SelectedItem="{Binding RulesMode}"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="b" Height="30" CornerRadius="15" Padding="13,0" Margin="0,0,6,6" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="Transparent">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="t" Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}" />
                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource AccentText}" />
                                        <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- categories -->
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding RuleCategories}" SelectedItem="{Binding RuleCategory}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" CornerRadius="6" Padding="10,8" Margin="0,0,0,2" Background="Transparent">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,0" MinWidth="20" Background="{StaticResource AccentSoftBg}" Margin="6,0,0,0"
                                                    Visibility="{Binding Changes, Converter={StaticResource Vis}}" ToolTip="Changed settings">
                                                <TextBlock Text="{Binding Changes}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftFg}" HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                                                       Visibility="{Binding Count, Converter={StaticResource Vis}}" />
                                            <TextBlock x:Name="t" Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource Bg2}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource Bg3}" />
                                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- rules list -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Visibility="{Binding ShowAdvancedRules, Converter={StaticResource VisNot}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource InfoBg}" BorderBrush="{StaticResource InfoBorder}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="14,9">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfoFg}"
                                   Text="Rules are written to Game.ini before the game starts, so bots and enemies spawn with your values from the first second, and are re-applied after the map loads. Gold values differ from the game default. Changes during a match can be pushed from the Live page." />
                    </Border>
                    <Grid Grid.Row="1" Margin="16,10,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SETTING" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" />
                        <TextBlock Grid.Column="1" Text="VALUE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" />
                        <TextBlock Grid.Column="2" Text="DEFAULT" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" Margin="10,0,0,0" />
                    </Grid>
                    <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding RuleItemsView}" Margin="0,0,0,6"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel"
                             ItemContainerStyle="{StaticResource PlainItem}" KeyboardNavigation.TabNavigation="Continue">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Bg4}" BorderThickness="0,1,0,0" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="label" Text="{Binding Label}" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Visibility="{Binding Changed, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="CHANGED" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftFg}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Mute}" Margin="0,2,0,0" Visibility="{Binding Description, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource MonoText}" FontSize="10.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" Content="{Binding}" Style="{StaticResource EditorHost}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayDefault}" Style="{StaticResource MonoText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayDefault}" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding ResetCommand}" ToolTip="Back to the default"
                                                Visibility="{Binding Changed, Converter={StaticResource Vis}}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                        <Setter TargetName="label" Property="Foreground" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- advanced -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Visibility="{Binding ShowAdvancedRules, Converter={StaticResource Vis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,16">
                    <StackPanel>
                        <TextBlock Text="OFFICIAL RULESET AT GAME START" Style="{StaticResource SectionLabel}" />
                        <DockPanel>
                            <ComboBox Width="240" ItemsSource="{Binding OfficialRulesetChoices}" SelectedItem="{Binding LaunchRuleset}" DockPanel.Dock="Left" />
                            <TextBlock Style="{StaticResource Mute}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="Starts the game with -ruleset=, exactly like the official playlist. Also changes things the rules list can't, like movement speed. Needs a game start." />
                        </DockPanel>

                        <TextBlock Text="EXTRA GAME.INI LINES" Style="{StaticResource SectionLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource SegmentHost}" DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Off" IsChecked="{Binding CustomIniMode, Converter={StaticResource Eq}, ConverterParameter=Off}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Add to Game.ini" IsChecked="{Binding CustomIniMode, Converter={StaticResource Eq}, ConverterParameter=Append}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Replace Game.ini" IsChecked="{Binding CustomIniMode, Converter={StaticResource Eq}, ConverterParameter=Replace}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Mute}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="For mutator settings and anything else. Replace keeps only the launcher's rules and these lines." />
                        </DockPanel>
                        <TextBox Style="{StaticResource CodeBox}" Height="170" Text="{Binding CustomIniText, UpdateSourceTrigger=LostFocus}"
                                 Tag="[/Script/Insurgency.INSCheckpointGameMode]&#x0a;SomeSetting=Value" />
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding ActiveMutatorSections.Count, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Mute}" Text="Insert the settings section of an active mutator:" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding ActiveMutatorSections}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11" Padding="8,4" Margin="0,0,6,6"
                                                Command="{Binding DataContext.InsertSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="COMMANDS AFTER THE MAP LOADS" Style="{StaticResource SectionLabel}" />
                        <TextBox Style="{StaticResource CodeBox}" Height="100" Text="{Binding AfterLoadCommands, UpdateSourceTrigger=LostFocus}"
                                 Tag="One console command per line, e.g.&#x0a;AdminExtendRoundTimer 600" />
                        <CheckBox Content="Turn on cheats after loading (EnableCheats)" IsChecked="{Binding EnableCheatsAfterLoad}" Margin="0,10,0,0" />

                        <TextBlock Text="TRAVEL URL" Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBox Text="{Binding ExtraUrlOptions, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Tag="Extra options, e.g. ?RoundTime=900" />
                                <TextBlock Style="{StaticResource Mute}" Margin="0,4,0,0" Text="Added to the end of the open command." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBox Text="{Binding GameModeOverride, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Tag="Game mode alias (?game=)" />
                                <TextBlock Style="{StaticResource Mute}" Margin="0,4,0,0" Text="e.g. CheckpointHardcore" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Load the map twice (for mods that only work after a second load)" IsChecked="{Binding ForceReload}" Margin="0,12,0,0" />

                        <TextBlock Text="WHAT THE LAUNCHER WILL DO" Style="{StaticResource SectionLabel}" Margin="0,22,0,6" />
                        <TextBlock Style="{StaticResource Mute}" Text="Console command" />
                        <TextBox Style="{StaticResource CodeBox}" IsReadOnly="True" Text="{Binding PlanCommand, Mode=OneWay}" TextWrapping="Wrap" Height="Auto" MinHeight="44" Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource Mute}" Text="Game.ini block (other lines in your Game.ini are kept)" />
                        <TextBox Style="{StaticResource CodeBox}" IsReadOnly="True" Text="{Binding PlanIni, Mode=OneWay}" Height="150" Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource Mute}" Text="After the map loads" />
                        <TextBox Style="{StaticResource CodeBox}" IsReadOnly="True" Text="{Binding PlanAfterLoad, Mode=OneWay}" Height="80" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- presets -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,14,16,8">
                        <TextBlock Text="PRESETS" Style="{StaticResource H2}" FontSize="16" />
                        <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,10" Text="One click sets many rules. Official rulesets are the exact values from the game files." />
                        <Border Style="{StaticResource SegmentHost}">
                            <UniformGrid Rows="1">
                                <RadioButton Style="{StaticResource Segment}" Content="Play styles" IsChecked="{Binding PresetFilter, Converter={StaticResource Eq}, ConverterParameter=Styles}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Official" IsChecked="{Binding PresetFilter, Converter={StaticResource Eq}, ConverterParameter=Official}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Mine" IsChecked="{Binding PresetFilter, Converter={StaticResource Eq}, ConverterParameter=Mine}" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding RulePresets}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE74D;" ToolTip="Delete preset"
                                                            Visibility="{Binding Group, Converter={StaticResource Vis}, ConverterParameter='My preset'}"
                                                            Command="{Binding DataContext.DeleteRulesPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Mute}" Margin="0,3,0,8" />
                                                <Button Content="Apply" HorizontalAlignment="Left" Padding="14,5"
                                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Mute}" Visibility="{Binding HasNoPresets, Converter={StaticResource Vis}}" Margin="4,4,4,0"
                                       Text="No presets yet. Change some rules and press &quot;Save as preset&quot;." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
