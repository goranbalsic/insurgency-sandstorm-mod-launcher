<UserControl x:Class="SandstormModLauncher.Views.Pages.PlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SandstormModLauncher.Views.Controls"
             xmlns:p="clr-namespace:SandstormModLauncher.Views.Pages">
    <UserControl.Resources>
        <!-- rule value editors, picked by the rule's type -->
        <DataTemplate x:Key="BoolEditor">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Bool}" HorizontalAlignment="Left" />
        </DataTemplate>
        <DataTemplate x:Key="NumberEditor">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="68" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="{Binding Min, Mode=OneWay}" Maximum="{Binding Max, Mode=OneWay}" Value="{Binding Number, Mode=OneWay}" SmallChange="{Binding Step, Mode=OneWay}"
                        LargeChange="{Binding Step, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="RuleSlider_ValueChanged" />
                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" FontSize="12.5" Padding="6,4"
                         HorizontalContentAlignment="Right" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="EnumEditor">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding EnumValue}" />
        </DataTemplate>
        <DataTemplate x:Key="TextEditor">
            <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" FontSize="12.5" Padding="6,4" />
        </DataTemplate>
        <Style x:Key="EditorHost" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ContentTemplate" Value="{StaticResource TextEditor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBool}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource BoolEditor}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsNumber}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource NumberEditor}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsEnum}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource EnumEditor}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="TabSegment" TargetType="RadioButton" BasedOn="{StaticResource PageTab}">
            <Setter Property="MinWidth" Value="84" />
        </Style>
        <!-- One preset (squad preset, rule style, official ruleset, playlist or saved setup). Co-op = PvE, solo or with AI teammates; Versus = against bots offline. -->
        <DataTemplate x:Key="PresetCard">
            <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Padding="11,9" Margin="0,0,8,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Apply" Padding="14,4"
                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource GhostButton}" Content="Delete" Padding="10,4" Margin="6,0,0,0" ToolTip="Delete this saved setup"
                                Visibility="{Binding Group, Converter={StaticResource Vis}, ConverterParameter='Saved'}"
                                Command="{Binding DataContext.DeleteRulesPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Padding="6,1" Margin="6,2,0,0" VerticalAlignment="Top" CornerRadius="2" BorderThickness="1"
                                    Visibility="{Binding HasTag, Converter={StaticResource Vis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource GoodBg}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource GoodBorder}" />
                                        <Setter Property="ToolTip" Value="Co-op (PvE): play it solo or with AI teammates" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVersus}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource InfoBg}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource InfoBorder}" />
                                                <Setter Property="ToolTip" Value="Versus (PvP): offline you play it against bots" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource GoodFg}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVersus}" Value="True"><Setter Property="Foreground" Value="{StaticResource InfoFg}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Mute}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Mute}" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <!-- A line of the match summary: what it is, the current value, and a click opens the tab that changes it. -->
        <Style x:Key="SummaryRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="2,8,2,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="{StaticResource TextMute}" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <ContentPresenter Grid.Column="1" />
                                <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource TextFaint}" Margin="8,2,0,0" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Bg3}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="root" Margin="20,18,20,16" SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="gapCol" Width="20" />
            <ColumnDefinition x:Name="summaryCol" Width="0.6*" MinWidth="330" MaxWidth="410" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <!-- ============================================================ header + tabs (full width, never moves) -->
            <Border Grid.ColumnSpan="3" Style="{StaticResource TabStrip}">
            <DockPanel x:Name="header" LastChildFill="False">
                <StackPanel x:Name="titleBox" DockPanel.Dock="Left" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Kicker}">
                        <Run Text="Play · " /><Run Text="{Binding RulesModeTitle, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="20" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource H1}">
                                <Setter Property="Text" Value="Map and scenario" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlayTab}" Value="Squad"><Setter Property="Text" Value="Bots and enemies" /></DataTrigger>
                                    <DataTrigger Binding="{Binding PlayTab}" Value="Rules"><Setter Property="Text" Value="Match rules" /></DataTrigger>
                                    <DataTrigger Binding="{Binding PlayTab}" Value="Live"><Setter Property="Text" Value="Live match control" /></DataTrigger>
                                    <DataTrigger Binding="{Binding PlayTab}" Value="Mods"><Setter Property="Text" Value="Mods and mutators" /></DataTrigger>
                                    <DataTrigger Binding="{Binding PlayTab}" Value="Advanced"><Setter Property="Text" Value="Advanced options" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border x:Name="tabsBox" DockPanel.Dock="Right" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabSegment}" IsChecked="{Binding PlayTab, Converter={StaticResource Eq}, ConverterParameter=Map}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE707;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Map" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabSegment}" IsChecked="{Binding PlayTab, Converter={StaticResource Eq}, ConverterParameter=Squad}"
                                     ToolTip="Teammates, enemies and AI difficulty, with presets">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Squad" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabSegment}" IsChecked="{Binding PlayTab, Converter={StaticResource Eq}, ConverterParameter=Rules}"
                                     ToolTip="Every match setting of the selected game mode, with presets">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9E9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding RulesTabLabel}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabSegment}" IsChecked="{Binding PlayTab, Converter={StaticResource Eq}, ConverterParameter=Mods}"
                                     ToolTip="Mutators for the match (official and from mods) and the mods the game has installed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA86;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Mods" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabSegment}" IsChecked="{Binding PlayTab, Converter={StaticResource Eq}, ConverterParameter=Live}"
                                     ToolTip="Control the running match: round, clock, bots, cheats and every console command">
                            <StackPanel Orientation="Horizontal">
                                <Grid Margin="0,0,8,0">
                                    <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="13" />
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Good}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                             Visibility="{Binding InMatch, Converter={StaticResource Vis}}" />
                                </Grid>
                                <TextBlock Text="Live" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabSegment}" IsChecked="{Binding PlayTab, Converter={StaticResource Eq}, ConverterParameter=Advanced}"
                                     ToolTip="Ruleset, extra Game.ini lines, commands after loading">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Advanced" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </DockPanel>
            </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================================ map toolbar -->
            <Grid Grid.Row="0" Margin="0,14,0,12" Visibility="{Binding PlayTab, Converter={StaticResource Vis}, ConverterParameter=Map}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MapFilter, Converter={StaticResource Eq}, ConverterParameter=All}">
                        <TextBlock><Run Text="All " /><Run Text="{Binding AllMapCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MapFilter, Converter={StaticResource Eq}, ConverterParameter=Official}">
                        <TextBlock><Run Text="Official " /><Run Text="{Binding OfficialMapCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MapFilter, Converter={StaticResource Eq}, ConverterParameter=Mods}">
                        <TextBlock><Run Text="Mod maps " /><Run Text="{Binding ModMapCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MapFilter, Converter={StaticResource Eq}, ConverterParameter=Custom}"
                                 Visibility="{Binding CustomMapCount, Converter={StaticResource Vis}}">
                        <TextBlock><Run Text="Custom " /><Run Text="{Binding CustomMapCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                </StackPanel>
                <!-- the search box gives up width first when the window is narrow or the text is large -->
                <Grid Grid.Column="1" MaxWidth="200" Margin="8,0,0,0" HorizontalAlignment="Stretch">
                    <TextBox Text="{Binding MapSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search maps" Padding="30,6,8,6" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding RandomMissionCommand}" ToolTip="Pick a random map and scenario (same kind as the current one)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Random" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding AddCustomMapCommand}" Margin="8,0,0,0"
                            ToolTip="Add a map by its level and scenario name">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Custom map" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================ rules toolbar -->
            <!-- search on its own line and the categories wrapping below it, so large text never squeezes them into one tall column -->
            <StackPanel Grid.Row="0" Margin="0,14,0,10" Visibility="{Binding PlayTab, Converter={StaticResource Vis}, ConverterParameter=Rules}">
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Reset mode" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding ResetModeCommand}"
                            ToolTip="Put every setting of this game mode back to the game default" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" MaxWidth="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RuleSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search every setting" Padding="30,6,8,6" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding RuleCategories}" SelectedItem="{Binding RuleCategory}" Margin="0,0,12,0"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Height="28" CornerRadius="2" Padding="11,0" Margin="0,0,6,6" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="Transparent">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="t" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextDim}" />
                                                <Border x:Name="n" CornerRadius="2" Padding="5,0" Margin="6,0,0,0" Background="{StaticResource AccentSoftBg}"
                                                        Visibility="{Binding Changes, Converter={StaticResource Vis}}" ToolTip="Changed settings">
                                                    <TextBlock Text="{Binding Changes}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftFg}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                                <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}" />
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="t" Property="Foreground" Value="{StaticResource AccentText}" />
                                                <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <!-- ============================================================ maps -->
            <Grid Grid.Row="1" Visibility="{Binding PlayTab, Converter={StaticResource Vis}, ConverterParameter=Map}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.55*" MinWidth="270" MaxWidth="360" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="mapScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding MapsView}" Margin="-6,-6,-6,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid VerticalAlignment="Top" Columns="{Binding ActualWidth, ElementName=mapScroll, Converter={StaticResource ColumnsFor}, ConverterParameter=215}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="6" Height="148" Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
                                        Command="{Binding DataContext.SelectMapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{Binding Counts}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="card" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Bg4}" Background="{StaticResource Bg2}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource Display}" FontSize="44" Foreground="{StaticResource Line}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,26" />
                                                    <Border CornerRadius="2">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Thumb, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                    <Border CornerRadius="0,0,7,7" Height="70" VerticalAlignment="Bottom">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                <GradientStop Color="#F2080909" Offset="0" />
                                                                <GradientStop Color="#00080909" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Grid VerticalAlignment="Bottom" Margin="12,0,12,9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="18" Foreground="{StaticResource TextBright}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" VerticalAlignment="Bottom" CornerRadius="2" Padding="7,2" Margin="8,0,0,2" Background="{StaticResource AccentSoftBg}"
                                                                Visibility="{Binding Tag, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftFg}" />
                                                        </Border>
                                                    </Grid>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                            Background="#B0101214" ToolTip="Edit this custom map"
                                                            Visibility="{Binding Custom, Converter={StaticResource Vis}}"
                                                            Command="{Binding DataContext.EditCustomMapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Border x:Name="check" Width="22" Height="22" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Margin="8" Visibility="Collapsed">
                                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="card" Property="BorderThickness" Value="2" />
                                                    <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding AllMapCount, Converter={StaticResource VisNot}}"
                           Text="No maps yet. Make sure the game folder is set in Settings." />
                <!-- scenario of the picked map -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,4,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mute}" VerticalAlignment="Bottom" Text="{Binding SelectedMap.Counts}" />
                            <TextBlock Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedMapTitle, StringFormat={}{0}}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ScenarioModeGroups}" Margin="0,4,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="1,8,0,6" />
                                        <ItemsControl ItemsSource="{Binding Modes}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Style="{StaticResource Chip}" Margin="0,0,6,6" GroupName="scenarioMode" Content="{Binding Mode}"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Tip}"
                                                                 Command="{Binding DataContext.SelectScenarioModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasScenarioSides, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                            <TextBlock Text="Side" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="1,0,0,6" />
                            <Border Style="{StaticResource SegmentHost}">
                                <ItemsControl ItemsSource="{Binding ScenarioSides}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="scenarioSide" Content="{Binding SideLabel}" IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Id}"
                                                         Command="{Binding DataContext.SelectScenarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedScenarioId}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="1,8,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="Scenario ID" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding Day}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE706;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0" />
                                            <TextBlock Text="Day" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding Night}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0" />
                                            <TextBlock Text="Night" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Well}" Margin="8,0,0,0" Padding="10,0">
                                <CheckBox Content="Hardcore" IsChecked="{Binding Hardcore}" IsEnabled="{Binding CanHardcore}" Foreground="{StaticResource TextDim}"
                                          ToolTip="Hardcore Checkpoint: no HUD, more damage, limited respawns (Checkpoint scenarios only)" />
                            </Border>
                        </Grid>
                        <c:Stepper Margin="0,8,0,0" Label="Player slots" Hint="MaxPlayers · raised automatically to fit AI teammates" Value="{Binding MaxPlayers}" Minimum="1" Maximum="64" />
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </Grid>

            <!-- ============================================================ squad: presets on the left, the values on the right -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Margin="0,14,0,0" Visibility="{Binding PlayTab, Converter={StaticResource Vis}, ConverterParameter=Squad}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.8*" MinWidth="300" MaxWidth="420" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="16,12,16,10">
                            <TextBlock Text="Presets" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,0" TextWrapping="Wrap">
                                <Run Text="For every" /> <Run Text="{Binding SquadKindLabel, Mode=OneWay}" /> <Run Text="mode. Applying one replaces the bot values it is about; fine-tune them on the right." />
                            </TextBlock>
                        </StackPanel>
                        <ScrollViewer x:Name="squadScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,6,8" Focusable="False">
                            <ItemsControl ItemsSource="{Binding SquadPresets}" ItemTemplate="{StaticResource PresetCard}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid VerticalAlignment="Top" Columns="{Binding ActualWidth, ElementName=squadScroll, Converter={StaticResource ColumnsFor}, ConverterParameter=210}" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,4,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Bots and enemies" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,3,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding CurrentModeName, Mode=OneWay}" /><Run Text=" defaults unless changed (gold)." />
                            </TextBlock>
                        <!-- co-op -->
                        <StackPanel Visibility="{Binding IsCoopMode, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                            <c:Stepper Margin="0,10,0,0" Label="AI teammates" Hint="{Binding TeammatesHint}" Value="{Binding Teammates}" Changed="{Binding TeammatesChanged}" Maximum="32"
                                       ToolTip="Bots on your team. Read at game start (the launcher restarts it if needed)." />
                            <c:Stepper Label="Enemies when playing alone" Hint="{Binding SoloEnemiesHint}" Value="{Binding SoloEnemies}" Changed="{Binding SoloEnemiesChanged}"
                                       ToolTip="Enemy bots alive at once when you are the only human player" />
                            <c:Stepper Label="Minimum enemies" Hint="{Binding MinEnemiesHint}" Value="{Binding MinEnemies}" Changed="{Binding MinEnemiesChanged}"
                                       ToolTip="Fewest enemy bots with a group of players" />
                            <c:Stepper Label="Maximum enemies" Hint="{Binding MaxEnemiesHint}" Value="{Binding MaxEnemies}" Changed="{Binding MaxEnemiesChanged}"
                                       ToolTip="Most enemy bots with a full group of players" />
                        </StackPanel>

                        <!-- versus -->
                        <StackPanel Visibility="{Binding IsVersusMode, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BotsEnabled}" Margin="0,4,0,6">
                                <StackPanel>
                                    <TextBlock Text="Fill teams with bots" FontSize="14" />
                                    <TextBlock Text="bBots · teams are always even" FontSize="11" Foreground="{StaticResource TextFaint}" />
                                </StackPanel>
                            </CheckBox>
                            <c:Stepper Label="Players per team" Hint="{Binding BotQuotaHint}" Value="{Binding BotQuota}" Changed="{Binding BotQuotaChanged}" Maximum="32"
                                       IsEnabled="{Binding BotsEnabled}" ToolTip="Size of each team. You take one slot on yours; bots fill the rest and the whole enemy team." />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AiDifficultyLabel}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="AI difficulty" FontSize="14" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="1" Value="{Binding AiDifficulty}" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                    ToolTip="How well bots aim, spot and react. 0.5 is the game default." />
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="Recruit" FontSize="11" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Left" />
                                <TextBlock Text="Default 0.50" FontSize="11" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                                <TextBlock Text="Nightmare" FontSize="11" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,6,0,0" Visibility="{Binding IsVersusMode, Converter={StaticResource Vis}}"
                                       TextWrapping="Wrap" Text="Versus: typed into the game console after the map loads, the one setting RCON cannot set (needs the game in front, and typing allowed in Settings)." />
                        </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- ============================================================ rules -->
            <Grid Grid.Row="1" Visibility="{Binding PlayTab, Converter={StaticResource Vis}, ConverterParameter=Rules}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.5*" MinWidth="250" MaxWidth="320" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource InfoBg}" BorderBrush="{StaticResource InfoBorder}" BorderThickness="0,0,0,1" CornerRadius="2,2,0,0" Padding="14,8">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfoFg}">
                                <Run Text="Settings of the" /> <Run Text="{Binding RulesModeTitle, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="mode. Gold = changed from the game default. Bots and enemies are on the Squad tab." />
                            </TextBlock>
                        </Border>
                        <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding RuleItemsView}" Margin="0,0,0,6"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel"
                                 ItemContainerStyle="{StaticResource PlainItem}" KeyboardNavigation.TabNavigation="Continue">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Bg4}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="150" />
                                                <ColumnDefinition Width="0.8*" MinWidth="110" MaxWidth="200" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock x:Name="label" Text="{Binding Label}" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Mute}" Margin="0,2,0,0" Visibility="{Binding Description, Converter={StaticResource Vis}}" />
                                                <TextBlock Text="{Binding AvailabilityNote}" FontSize="12" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding AvailabilityNote, Converter={StaticResource Vis}}" />
                                                <TextBlock Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0">
                                                    <Run Text="{Binding Key, Mode=OneWay}" /><Run Text="  ·  default " /><Run Text="{Binding DisplayDefault, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <ContentControl Grid.Column="1" Content="{Binding}" Style="{StaticResource EditorHost}" VerticalAlignment="Center"
                                                            IsEnabled="{Binding IsAvailable}" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding ResetCommand}" ToolTip="Back to the default"
                                                    Visibility="{Binding Changed, Converter={StaticResource Vis}}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Changed}" Value="True">
                                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- presets -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="14,12,14,8">
                            <TextBlock Text="Presets" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,10" TextWrapping="Wrap" Text="One click sets many rules." />
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" Padding="6,0" Content="Styles" IsChecked="{Binding PresetFilter, Converter={StaticResource Eq}, ConverterParameter=Styles}" />
                                    <RadioButton Style="{StaticResource Segment}" Padding="6,0" Content="Official" IsChecked="{Binding PresetFilter, Converter={StaticResource Eq}, ConverterParameter=Official}" />
                                    <RadioButton Style="{StaticResource Segment}" Padding="6,0" Content="Playlists" IsChecked="{Binding PresetFilter, Converter={StaticResource Eq}, ConverterParameter=Playlists}"
                                                 ToolTip="The official online playlists: their mutators and rules, added to the map you picked" />
                                    <RadioButton Style="{StaticResource Segment}" Padding="6,0" Content="Saved" IsChecked="{Binding PresetFilter, Converter={StaticResource Eq}, ConverterParameter=Saved}" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0,10,8">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding RulePresets}" ItemTemplate="{StaticResource PresetCard}" Focusable="False" />
                                <TextBlock Style="{StaticResource Mute}" Visibility="{Binding HasNoPresets, Converter={StaticResource Vis}}" Margin="4,4,4,0" TextWrapping="Wrap"
                                           Text="Nothing saved yet. &quot;Save setup as a preset&quot; below keeps the whole match: map, scenario, bots, every rule and the mutators." />
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="14,4,14,12">
                            <Button Content="Save setup as a preset..." Command="{Binding SaveRulesPresetCommand}" ToolTip="Saves everything: map, scenario, bots, every rule and the mutators" />
                            <Button Content="Reset every mode" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Command="{Binding ResetAllRulesCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ playlists + live -->
            <p:LivePage Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding PlayTab, Converter={StaticResource Vis}, ConverterParameter=Live}" />
            <p:ModsPage Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding PlayTab, Converter={StaticResource Vis}, ConverterParameter=Mods}" />

            <!-- ============================================================ advanced -->
            <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0" Visibility="{Binding PlayTab, Converter={StaticResource Vis}, ConverterParameter=Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,16">
                    <StackPanel>
                        <TextBlock Text="Official ruleset at game start" Style="{StaticResource SectionLabel}" />
                        <DockPanel>
                            <ComboBox Width="240" ItemsSource="{Binding OfficialRulesetChoices}" SelectedItem="{Binding LaunchRuleset}" DockPanel.Dock="Left" />
                            <TextBlock Style="{StaticResource Mute}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Starts the game with -ruleset= like the official playlist. Needs a game start." />
                        </DockPanel>

                        <TextBlock Text="Extra Game.ini lines" Style="{StaticResource SectionLabel}" />
                        <DockPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource SegmentHost}" DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Off" IsChecked="{Binding CustomIniMode, Converter={StaticResource Eq}, ConverterParameter=Off}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Add to Game.ini" IsChecked="{Binding CustomIniMode, Converter={StaticResource Eq}, ConverterParameter=Append}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Replace Game.ini" IsChecked="{Binding CustomIniMode, Converter={StaticResource Eq}, ConverterParameter=Replace}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Mute}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Replace keeps only the launcher's rules and these lines." />
                        </DockPanel>
                        <TextBox Style="{StaticResource CodeBox}" Height="150" Text="{Binding CustomIniText, UpdateSourceTrigger=LostFocus}"
                                 Tag="[/Script/Insurgency.INSCheckpointGameMode]&#x0a;SomeSetting=Value" />
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding ActiveMutatorSections.Count, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Mute}" Text="Insert the settings section of an active mutator:" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding ActiveMutatorSections}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11" Padding="8,4" Margin="0,0,6,6"
                                                Command="{Binding DataContext.InsertSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="Commands after the map loads" Style="{StaticResource SectionLabel}" />
                        <TextBox Style="{StaticResource CodeBox}" Height="90" Text="{Binding AfterLoadCommands, UpdateSourceTrigger=LostFocus}"
                                 Tag="One console command per line, e.g.&#x0a;SetRoundTimer 1800" />
                        <CheckBox Content="Turn on cheats after loading (EnableCheats)" IsChecked="{Binding EnableCheatsAfterLoad}" Margin="0,10,0,0" />

                        <TextBlock Text="Travel URL" Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBox Text="{Binding ExtraUrlOptions, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Tag="Extra options, e.g. ?RoundTime=900" />
                                <TextBlock Style="{StaticResource Mute}" Margin="0,4,0,0" Text="Added to the end of the open command." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBox Text="{Binding GameModeOverride, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Tag="Game mode alias (?game=)" />
                                <TextBlock Style="{StaticResource Mute}" Margin="0,4,0,0" Text="e.g. CheckpointHardcore" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Load the map twice (for mods that only work after a second load)" IsChecked="{Binding ForceReload}" Margin="0,12,0,0" />

                        <TextBlock Text="What the launcher will do" Style="{StaticResource SectionLabel}" Margin="0,22,0,6" />
                        <TextBlock Style="{StaticResource Mute}" Text="Console command" />
                        <TextBox Style="{StaticResource CodeBox}" IsReadOnly="True" Text="{Binding PlanCommand, Mode=OneWay}" TextWrapping="Wrap" Height="Auto" MinHeight="44" Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource Mute}" Text="Game.ini block (other lines in your Game.ini are kept)" />
                        <TextBox Style="{StaticResource CodeBox}" IsReadOnly="True" Text="{Binding PlanIni, Mode=OneWay}" Height="150" Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource Mute}" Text="After the map loads" />
                        <TextBox Style="{StaticResource CodeBox}" IsReadOnly="True" Text="{Binding PlanAfterLoad, Mode=OneWay}" Height="80" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================================ your match: the same summary on every tab (click a line to change it) -->
        <ScrollViewer x:Name="summary" Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,4,0">
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Border x:Name="summaryThumb" Height="130" CornerRadius="2,2,0,0" Background="{StaticResource Bg3}">
                        <Grid>
                            <Border CornerRadius="2,2,0,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding SelectedMap.Thumb, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border VerticalAlignment="Bottom" Height="56">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#F2080909" Offset="0" />
                                        <GradientStop Color="#00080909" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,8">
                                <TextBlock Text="Your match" FontSize="11" Foreground="{StaticResource TextDim}" />
                                <TextBlock Text="{Binding SelectedMapTitle}" FontFamily="{StaticResource Display}" FontSize="17" Foreground="{StaticResource TextBright}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="14,6,14,14">
                        <TextBlock Style="{StaticResource Mute}" Margin="2,2,0,4" TextTrimming="CharacterEllipsis" Visibility="{Binding ActivePresetName, Converter={StaticResource Vis}}">
                            <Run Text="Preset: " /><Run Text="{Binding ActivePresetName, Mode=OneWay}" Foreground="{StaticResource AccentSoftFg}" />
                        </TextBlock>
                        <Button Style="{StaticResource SummaryRow}" Tag="Scenario" Command="{Binding PlayTabCommand}" CommandParameter="Map" ToolTip="Map, mode, side, day or night">
                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding ModeSummary, Mode=OneWay}" /><LineBreak /><Run Text="{Binding MapSummary, Mode=OneWay}" Foreground="{StaticResource TextDim}" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource SummaryRow}" Tag="Bots" Command="{Binding PlayTabCommand}" CommandParameter="Squad" ToolTip="Teammates, enemies and difficulty">
                            <TextBlock Text="{Binding SquadSummary}" TextWrapping="Wrap" />
                        </Button>
                        <Button Style="{StaticResource SummaryRow}" Tag="Rules" Command="{Binding PlayTabCommand}" CommandParameter="Rules" ToolTip="Every match setting, presets and playlists">
                            <TextBlock Text="{Binding RulesSummary}" TextWrapping="Wrap" />
                        </Button>
                        <Button Style="{StaticResource SummaryRow}" Tag="Mutators" Command="{Binding ModsTabCommand}" CommandParameter="Mutators" ToolTip="Pick mutators and their load order">
                            <TextBlock Text="{Binding MutatorSummary}" TextWrapping="Wrap" />
                        </Button>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MutatorsEnabled}" Margin="2,10,0,0" Foreground="{StaticResource TextDim}"
                                  Content="Load the mutators" ToolTip="Turn off to play without mutators but keep your selection" />
                        <TextBlock Text="{Binding PlanError}" Style="{StaticResource Mute}" Foreground="{StaticResource Warn}" Margin="2,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding PlanError, Converter={StaticResource Vis}}" />
                        <UniformGrid Rows="1" Margin="0,14,0,0">
                            <Button Content="Save setup..." Margin="0,0,4,0" Command="{Binding SaveRulesPresetCommand}"
                                    ToolTip="Save everything (map, scenario, bots, rules, mutators) as a preset. Find it under Rules > Presets > Saved." />
                            <Button Content="Reset..." Style="{StaticResource GhostButton}" Margin="4,0,0,0" Command="{Binding ResetSetupCommand}"
                                    ToolTip="Bots, enemies, every rule and the mutators back to the game defaults (map stays)" />
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
