<UserControl x:Class="SandstormModLauncher.Views.Pages.PlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SandstormModLauncher.Views.Controls">
    <Grid Margin="20,18,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="410" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ maps -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="STEP 1" Style="{StaticResource Kicker}" />
                    <TextBlock Text="Choose your operation" Style="{StaticResource H1}" FontSize="28" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RandomMissionCommand}" ToolTip="Pick a random map and scenario (same kind as the current one)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Random mission" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding AddCustomMapCommand}" Margin="8,0,0,0"
                            ToolTip="Add a map by its level and scenario name (for mod maps the launcher cannot read, or special test scenarios)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Custom map" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,14,0,12" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MapFilter, Converter={StaticResource Eq}, ConverterParameter=All}">
                        <TextBlock><Run Text="All " /><Run Text="{Binding AllMapCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MapFilter, Converter={StaticResource Eq}, ConverterParameter=Official}">
                        <TextBlock><Run Text="Official " /><Run Text="{Binding OfficialMapCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MapFilter, Converter={StaticResource Eq}, ConverterParameter=Mods}">
                        <TextBlock><Run Text="Mod maps " /><Run Text="{Binding ModMapCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MapFilter, Converter={StaticResource Eq}, ConverterParameter=Custom}"
                                 Visibility="{Binding CustomMapCount, Converter={StaticResource Vis}}">
                        <TextBlock><Run Text="Custom " /><Run Text="{Binding CustomMapCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                </StackPanel>
                <Grid DockPanel.Dock="Right" Width="230">
                    <TextBox Text="{Binding MapSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search maps" Padding="30,6,8,6" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>

            <ScrollViewer x:Name="mapScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding MapsView}" Margin="-6,-6,-6,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid VerticalAlignment="Top" Columns="{Binding ActualWidth, ElementName=mapScroll, Converter={StaticResource ColumnsFor}, ConverterParameter=215}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="6" Height="148" Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
                                    Command="{Binding DataContext.SelectMapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                    ToolTip="{Binding Counts}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="card" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Bg4}" Background="{StaticResource Bg2}">
                                            <Grid>
                                                <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource Display}" FontSize="44" Foreground="#2B3036"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,26" />
                                                <Border CornerRadius="7">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Thumb, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <Border CornerRadius="0,0,7,7" Height="70" VerticalAlignment="Bottom">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                            <GradientStop Color="#F2080909" Offset="0" />
                                                            <GradientStop Color="#00080909" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Grid VerticalAlignment="Bottom" Margin="12,0,12,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="18" Foreground="#F4F1EC" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" VerticalAlignment="Bottom" CornerRadius="4" Padding="7,2" Margin="8,0,0,2" Background="{StaticResource AccentSoftBg}"
                                                            Visibility="{Binding Tag, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftFg}" />
                                                    </Border>
                                                </Grid>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                        Background="#B0101214" ToolTip="Edit this custom map"
                                                        Visibility="{Binding Custom, Converter={StaticResource Vis}}"
                                                        Command="{Binding DataContext.EditCustomMapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <Border x:Name="check" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="8" Visibility="Collapsed">
                                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="card" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Visibility="{Binding AllMapCount, Converter={StaticResource VisNot}}"
                       Text="No maps yet. Make sure the game folder is set in Settings." />
        </Grid>

        <!-- ============================================================ setup column -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,4,0">
            <StackPanel>
                <!-- scenario -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mute}" VerticalAlignment="Bottom" Text="{Binding SelectedMap.Counts}" />
                            <TextBlock Style="{StaticResource H2}" FontSize="16" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedMapTitle, Converter={StaticResource Upper}, StringFormat={}{0} · SCENARIO}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ScenarioModeGroups}" Margin="0,4,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="1,8,0,6" />
                                        <ItemsControl ItemsSource="{Binding Modes}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Style="{StaticResource Chip}" Margin="0,0,6,6" GroupName="scenarioMode" Content="{Binding Mode}"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Tip}"
                                                                 Command="{Binding DataContext.SelectScenarioModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasScenarioSides, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                            <TextBlock Text="SIDE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="1,0,0,6" />
                            <Border Style="{StaticResource SegmentHost}">
                                <ItemsControl ItemsSource="{Binding ScenarioSides}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="scenarioSide" Content="{Binding SideLabel}" IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Id}"
                                                         Command="{Binding DataContext.SelectScenarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedScenarioId}" Style="{StaticResource MonoText}" FontSize="10.5" Foreground="{StaticResource TextFaint}" Margin="1,8,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="Scenario ID" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding Day}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE706;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0" />
                                            <TextBlock Text="Day" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding Night}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0" />
                                            <TextBlock Text="Night" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Well}" Margin="8,0,0,0" Padding="10,0">
                                <CheckBox Content="Hardcore" IsChecked="{Binding Hardcore}" IsEnabled="{Binding CanHardcore}" Foreground="{StaticResource TextDim}"
                                          ToolTip="Hardcore Checkpoint: no HUD, more damage, limited respawns (Checkpoint scenarios only)" />
                            </Border>
                        </Grid>
                        <c:Stepper Margin="0,8,0,0" Label="Player slots" Hint="MaxPlayers · room for friends joining your game" Value="{Binding MaxPlayers}" Minimum="1" Maximum="64" />
                    </StackPanel>
                </Border>

                <!-- squad & enemies -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="All match rules" Command="{Binding NavigateCommand}" CommandParameter="Rules" VerticalAlignment="Bottom" />
                            <TextBlock Text="SQUAD &amp; ENEMIES" Style="{StaticResource H2}" FontSize="16" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Mute}" Margin="0,3,0,0">
                            <Run Text="{Binding CurrentModeName, Mode=OneWay}" /><Run Text=" defaults are used unless you change them. Changed values turn gold." />
                        </TextBlock>

                        <StackPanel Visibility="{Binding IsCoopMode, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" Content="Lone Wolf" MinHeight="34" IsChecked="{Binding PlayStyle, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=LoneWolf}"
                                                 Command="{Binding PlayStyleCommand}" CommandParameter="LoneWolf" ToolTip="No AI teammates: just you against the enemy" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Squad" MinHeight="34" IsChecked="{Binding PlayStyle, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Squad}"
                                                 Command="{Binding PlayStyleCommand}" CommandParameter="Squad" ToolTip="Fight alongside AI teammates" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Defaults" MinHeight="34" IsChecked="{Binding PlayStyle, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Defaults}"
                                                 Command="{Binding PlayStyleCommand}" CommandParameter="Defaults" ToolTip="Reset bots and enemies to this mode's defaults" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Custom" MinHeight="34" IsChecked="{Binding PlayStyle, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Custom}"
                                                 IsHitTestVisible="False" Focusable="False" ToolTip="Your own mix of the values below" />
                                </UniformGrid>
                            </Border>
                            <c:Stepper Margin="0,10,0,0" Label="AI teammates" Hint="{Binding TeammatesHint}" Value="{Binding Teammates}" Changed="{Binding TeammatesChanged}" Maximum="32"
                                       ToolTip="Bots on your team. The game reads this when it starts, so changing it may need a game restart (the launcher handles it)." />
                            <c:Stepper Label="Enemies when playing alone" Hint="{Binding SoloEnemiesHint}" Value="{Binding SoloEnemies}" Changed="{Binding SoloEnemiesChanged}"
                                       ToolTip="Enemy bots alive at once when you are the only human player" />
                            <c:Stepper Label="Minimum enemies" Hint="{Binding MinEnemiesHint}" Value="{Binding MinEnemies}" Changed="{Binding MinEnemiesChanged}"
                                       ToolTip="Fewest enemy bots with a group of players" />
                            <c:Stepper Label="Maximum enemies" Hint="{Binding MaxEnemiesHint}" Value="{Binding MaxEnemies}" Changed="{Binding MaxEnemiesChanged}"
                                       ToolTip="Most enemy bots with a full group of players" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsVersusMode, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BotsEnabled}" Margin="0,2,0,6">
                                <StackPanel>
                                    <TextBlock Text="Fill teams with bots" FontSize="14" />
                                    <TextBlock Text="bBots · bots join both teams" FontSize="11" Foreground="{StaticResource TextFaint}" />
                                </StackPanel>
                            </CheckBox>
                            <c:Stepper Label="Bots in the match" Hint="{Binding BotQuotaHint}" Value="{Binding BotQuota}" Changed="{Binding BotQuotaChanged}" Maximum="64"
                                       IsEnabled="{Binding BotsEnabled}" ToolTip="Total number of bots, split across both teams" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AiDifficultyLabel}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="AI difficulty" FontSize="14" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="1" Value="{Binding AiDifficulty}" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                    ToolTip="How well bots aim, spot and react. 0.5 is the game default." />
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="RECRUIT" FontSize="10" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Left" />
                                <TextBlock Text="DEFAULT 0.50" FontSize="10" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                                <TextBlock Text="NIGHTMARE" FontSize="10" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,6,0,0" Visibility="{Binding IsVersusMode, Converter={StaticResource Vis}}"
                                       Text="In versus modes the difficulty is applied right after the map loads." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- mutators -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Manage" Command="{Binding NavigateCommand}" CommandParameter="Mutators" VerticalAlignment="Bottom" />
                            <TextBlock Style="{StaticResource H2}" FontSize="16">
                                <Run Text="MUTATORS · " /><Run Text="{Binding ActiveMutatorCount, Mode=OneWay}" /><Run Text=" ACTIVE" />
                            </TextBlock>
                        </DockPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MutatorsEnabled}" Margin="0,10,0,4" Foreground="{StaticResource TextDim}"
                                  Content="Load mutators with the match" ToolTip="Turn off to play without mutators but keep your selection" />
                        <ItemsControl ItemsSource="{Binding ActiveMutators}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="28" CornerRadius="14" Background="#1F2428" BorderBrush="#2F353B" BorderThickness="1" Padding="11,0,4,0" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="7,0,0,0" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                            <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="9" Content="&#xE711;" Margin="4,0,0,0" ToolTip="Remove"
                                                    Command="{Binding DataContext.RemoveMutatorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Mute}" Visibility="{Binding ActiveMutatorCount, Converter={StaticResource VisNot}}"
                                   Text="No mutators. Add some on the Mutators page, or pick an official playlist." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
