<UserControl x:Class="SandstormModLauncher.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="SwitchRow" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="20,18,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Game folder, console key and launch options" Style="{StaticResource Kicker}" />
                <TextBlock Text="Settings" Style="{StaticResource H1}" FontSize="20" Margin="0,2,0,0" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- game -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="2" Padding="9,2" BorderThickness="1"
                                        Background="{Binding GameFound, Converter={StaticResource Status}, ConverterParameter=bg}"
                                        BorderBrush="{Binding GameFound, Converter={StaticResource Status}, ConverterParameter=border}">
                                    <TextBlock FontSize="11" Foreground="{Binding GameFound, Converter={StaticResource Status}}">
                                        <Run Text="{Binding GameStore, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding GameBuild, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="Insurgency: Sandstorm" Style="{StaticResource H2}" />
                            </DockPanel>
                            <TextBlock Text="Game folder" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource Well}" Padding="10,7">
                                <TextBlock Text="{Binding GameDir}" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Change folder..." Margin="0,0,8,6" Command="{Binding ChangeGameDirCommand}" />
                                <Button Content="Find automatically" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding ResetGameDirCommand}" />
                                <Button Content="Open game folder" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenPathCommand}" CommandParameter="Game" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Mute}" Text="Game files are never changed, only Game.ini and Input.ini (backed up)." />
                        </StackPanel>
                    </Border>

                    <!-- console key -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Console key" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Used to send the match. Nothing is typed unless the console is seen open." />
                            <Border CornerRadius="2" Padding="12,9" Margin="0,12,0,0" BorderThickness="1"
                                    Background="{Binding ConsoleKeyOk, Converter={StaticResource Status}, ConverterParameter=bg}"
                                    BorderBrush="{Binding ConsoleKeyOk, Converter={StaticResource Status}, ConverterParameter=border}">
                                <TextBlock Text="{Binding ConsoleKeyStatus}" Foreground="{Binding ConsoleKeyOk, Converter={StaticResource Status}}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,8,0,0">
                                <Run Text="Console keys in the game: " /><Run Text="{Binding ConsoleKeysText, Mode=OneWay}" Foreground="{StaticResource Text}" />
                            </TextBlock>
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding AutoConsoleKey}" Margin="0,10,0,4">
                                <StackPanel>
                                    <TextBlock Text="Add F10 as a console key automatically" FontSize="13.5" />
                                    <TextBlock Text="Works on every keyboard layout, unlike the ` key." Style="{StaticResource Mute}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Set up F10 now" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding SetupF10Command}" />
                                <Button Content="Check again" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding RefreshConsoleKeyCommand}" />
                                <Button Content="Open Input.ini" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenPathCommand}" CommandParameter="InputIni" />
                            </WrapPanel>
                            <TextBlock Text="How to enter commands" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" Content="Paste (fast)" IsChecked="{Binding InputMethod, Converter={StaticResource Eq}, ConverterParameter=Paste}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Type" IsChecked="{Binding InputMethod, Converter={StaticResource Eq}, ConverterParameter=Type}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Style="{StaticResource Label}">
                                <Run Text="Key delay · " /><Run Text="{Binding KeyDelayMs, Mode=OneWay}" /><Run Text=" ms" />
                            </TextBlock>
                            <Slider Minimum="30" Maximum="250" Value="{Binding KeyDelayMs}" TickFrequency="10" IsSnapToTickEnabled="True"
                                    ToolTip="Raise this if commands arrive cut off on a slow PC" />
                        </StackPanel>
                    </Border>

                    <!-- key bindings -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Game key bindings" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Never edited. Copies are kept, so you can put them back if they are lost." />
                            <Border Background="{StaticResource BadBg}" CornerRadius="2" Padding="12,9" Margin="0,10,0,0" Visibility="{Binding KeyBindingsWarning, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Dismiss" Command="{Binding DismissKeyWarningCommand}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding KeyBindingsWarning}" Foreground="{StaticResource BadFg}" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Saved copies" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Restore" Margin="8,0,0,0" Command="{Binding RestoreKeyBindingsCommand}" />
                                <ComboBox ItemsSource="{Binding KeyBindingBackups}" SelectedItem="{Binding SelectedKeyBackup}" DisplayMemberPath="Label" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,6,0,0" Text="No copies yet."
                                       Visibility="{Binding KeyBindingBackups.Count, Converter={StaticResource VisNot}}" />
                        </StackPanel>
                    </Border>

                    <!-- mods -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Mod folders" Style="{StaticResource H2}" />
                            <TextBlock Text="THE GAME'S MOD FOLDER" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Open" Command="{Binding OpenPathCommand}" CommandParameter="Modio" />
                                <Border Style="{StaticResource Well}" Padding="10,7">
                                    <TextBlock Text="{Binding ModioRoot}" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="Extra folders with .pak files" Style="{StaticResource Label}" />
                            <ItemsControl ItemsSource="{Binding ExtraModFolders}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                                    Command="{Binding DataContext.RemoveModFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Border Style="{StaticResource Well}" Padding="10,7">
                                                <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Mute}" Visibility="{Binding ExtraModFolders.Count, Converter={StaticResource VisNot}}"
                                       Text="None. Only needed for mods you installed by hand." />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Add folder..." Margin="0,0,8,6" Command="{Binding AddModFolderCommand}" />
                                <Button Content="Rescan mods" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding RescanModsCommand}" />
                                <Button Content="Rebuild catalog" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding ClearCacheCommand}"
                                        ToolTip="Re-read every map, mutator and mod from the game files (after a game update)" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- text size -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mute}" VerticalAlignment="Bottom" Text="Ctrl + / Ctrl - / Ctrl 0, or Ctrl + mouse wheel" />
                                <TextBlock Text="Text size" Style="{StaticResource H2}" />
                            </DockPanel>
                            <Border Style="{StaticResource SegmentHost}" Margin="0,10,0,0">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" Content="90%" IsChecked="{Binding UiScaleText, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=90%}" Command="{Binding SetUiScaleCommand}" CommandParameter="0.9" />
                                    <RadioButton Style="{StaticResource Segment}" Content="100%" IsChecked="{Binding UiScaleText, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=100%}" Command="{Binding SetUiScaleCommand}" CommandParameter="1.0" />
                                    <RadioButton Style="{StaticResource Segment}" Content="110%" IsChecked="{Binding UiScaleText, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=110%}" Command="{Binding SetUiScaleCommand}" CommandParameter="1.1" />
                                    <RadioButton Style="{StaticResource Segment}" Content="125%" IsChecked="{Binding UiScaleText, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=125%}" Command="{Binding SetUiScaleCommand}" CommandParameter="1.25" />
                                    <RadioButton Style="{StaticResource Segment}" Content="140%" IsChecked="{Binding UiScaleText, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=140%}" Command="{Binding SetUiScaleCommand}" CommandParameter="1.4" />
                                    <RadioButton Style="{StaticResource Segment}" Content="150%" IsChecked="{Binding UiScaleText, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=150%}" Command="{Binding SetUiScaleCommand}" CommandParameter="1.5" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- launching -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Launching" Style="{StaticResource H2}" />
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding AutoStartGame}" Margin="0,12,0,6">
                                <StackPanel>
                                    <TextBlock Text="Start the game automatically" FontSize="13.5" />
                                    <TextBlock Text="Through Steam or Epic when it is not running" Style="{StaticResource Mute}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding MinimizeOnLaunch}">
                                <StackPanel>
                                    <TextBlock Text="Minimize the launcher after launching" FontSize="13.5" />
                                    <TextBlock Text="Gets out of your way once the match has loaded" Style="{StaticResource Mute}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding ApplyLiveRules}">
                                <StackPanel>
                                    <TextBlock Text="Apply rules again after the map loads" FontSize="13.5" />
                                    <TextBlock Text="Also sends rules as admin commands, no restart needed" Style="{StaticResource Mute}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding SoloGameFlag}">
                                <StackPanel>
                                    <TextBlock Text="Mark matches as solo games (bSoloGame)" FontSize="13.5" />
                                    <TextBlock Text="Turn off to host friends over LAN" Style="{StaticResource Mute}" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="When AI teammates need a game restart" Style="{StaticResource Label}" />
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" Content="Ask me" IsChecked="{Binding RestartPolicy, Converter={StaticResource Eq}, ConverterParameter=Ask}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Restart" IsChecked="{Binding RestartPolicy, Converter={StaticResource Eq}, ConverterParameter=Always}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Never" IsChecked="{Binding RestartPolicy, Converter={StaticResource Eq}, ConverterParameter=Never}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Extra game start options" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding LaunchArgs, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Mono}" Tag="e.g. -nomovies" />
                            <TextBlock Style="{StaticResource Label}">
                                <Run Text="Wait for the game up to · " /><Run Text="{Binding StartTimeoutSec, Mode=OneWay}" /><Run Text=" s" />
                            </TextBlock>
                            <Slider Minimum="60" Maximum="900" Value="{Binding StartTimeoutSec}" TickFrequency="30" IsSnapToTickEnabled="True" />
                        </StackPanel>
                    </Border>

                    <!-- files -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Files and tools" Style="{StaticResource H2}" />
                            <TextBlock Text="Open" Style="{StaticResource Label}" />
                            <WrapPanel>
                                <Button Content="Game.ini" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenPathCommand}" CommandParameter="GameIni" />
                                <Button Content="Config folder" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenPathCommand}" CommandParameter="Config" />
                                <Button Content="Game logs" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenPathCommand}" CommandParameter="GameLogs" />
                                <Button Content="Backups" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenPathCommand}" CommandParameter="Backups" />
                                <Button Content="Launcher data" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenPathCommand}" CommandParameter="Data" />
                                <Button Content="Launcher log" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenPathCommand}" CommandParameter="Logs" />
                                <Button Content="Problem reports" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenPathCommand}" CommandParameter="Reports" />
                            </WrapPanel>
                            <TextBlock Text="Tools" Style="{StaticResource Label}" />
                            <WrapPanel>
                                <Button Content="Desktop shortcut" Margin="0,0,8,6" Command="{Binding CreateShortcutCommand}" />
                                <Button Content="Remove launcher rules from Game.ini" Style="{StaticResource DangerButton}" Margin="0,0,8,6" Command="{Binding RemoveIniRulesCommand}" />
                            </WrapPanel>
                            <TextBlock Text="Something went wrong?" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Send a report..." Style="{StaticResource AccentButton}" Margin="8,0,0,0" Command="{Binding PrepareShareCommand}"
                                        ToolTip="Shows the report first. Nothing is sent until you press Send." />
                                <Button DockPanel.Dock="Right" Content="Save report" Margin="8,0,0,0" Command="{Binding SaveReportCommand}" />
                                <TextBox Text="{Binding ReportNote, UpdateSourceTrigger=PropertyChanged}" Tag="What happened? (optional)" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Save report keeps logs on this PC. Send a report shows a cleaned report first (no names, IDs or screenshots); nothing leaves your PC until you press Send." />
                            <Border x:Name="sharePanel" Style="{StaticResource Well}" Padding="12,10" Margin="0,10,0,0" Visibility="{Binding ShareReportOpen, Converter={StaticResource Vis}}"
                                    IsVisibleChanged="SharePanel_IsVisibleChanged">
                                <StackPanel>
                                    <TextBlock Text="This is everything that would be sent" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,8" TextWrapping="Wrap"
                                               Text="Send goes to the developer's private report inbox, only this text, once. Cancel if anything looks private." />
                                    <TextBox Style="{StaticResource CodeBox}" IsReadOnly="True" Height="240" Text="{Binding ShareReportText, Mode=OneWay}" FontSize="11.5" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Post it on GitHub instead" VerticalAlignment="Center" Command="{Binding SendShareCommand}"
                                                ToolTip="Opens the public GitHub issue form (needs a GitHub account)" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Cancel" Command="{Binding CancelShareCommand}" />
                                            <Button Content="Send" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="18,5" Command="{Binding SendReportCommand}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,6,0,0">
                                <Run Text="Launcher data is stored in " /><Run Text="{Binding DataDir, Mode=OneWay}" Foreground="{StaticResource TextDim}" /><Run Text=" (an empty file named &quot;portable&quot; next to the exe keeps it there)." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- about -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource TextMute}" VerticalAlignment="Bottom" />
                                <TextBlock Text="About" Style="{StaticResource H2}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,6,0,0"
                                       Text="Source available: the code is public to read and check, all rights reserved. Not affiliated with New World Interactive or Focus Entertainment." />
                            <CheckBox Style="{StaticResource SwitchRow}" IsChecked="{Binding AutoUpdate}" Margin="0,12,0,4">
                                <StackPanel>
                                    <TextBlock Text="Keep the launcher up to date" FontSize="13.5" />
                                    <TextBlock Text="{Binding AutoUpdateHint, Mode=OneTime}" Style="{StaticResource Mute}" />
                                </StackPanel>
                            </CheckBox>
                            <DockPanel Margin="0,4,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Restart now" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Command="{Binding RestartToUpdateCommand}"
                                            Visibility="{Binding UpdateReady, Converter={StaticResource Vis}}" />
                                    <Button Content="Download" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding OpenUpdatePageCommand}"
                                            Visibility="{Binding UpdateDownloadOnly, Converter={StaticResource Vis}}" />
                                    <Button Content="Check now" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding CheckUpdatesCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Mute}" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="Source code" Margin="0,0,16,4" Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/goranbalsic/insurgency-sandstorm-mod-launcher" />
                                <Button Style="{StaticResource LinkButton}" Content="Releases" Margin="0,0,16,4" Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/goranbalsic/insurgency-sandstorm-mod-launcher/releases" />
                                <Button Style="{StaticResource LinkButton}" Content="Report a problem" Margin="0,0,16,4" Command="{Binding OpenUrlCommand}"
                                        CommandParameter="https://github.com/goranbalsic/insurgency-sandstorm-mod-launcher/issues" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
