<UserControl x:Class="SandstormModLauncher.Views.Pages.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,14,0,0" CornerRadius="2" Padding="14,10" BorderThickness="1"
                Background="{Binding GameStatusKind, Converter={StaticResource Status}, ConverterParameter=bg}"
                BorderBrush="{Binding GameStatusKind, Converter={StaticResource Status}, ConverterParameter=border}">
            <DockPanel>
                <Ellipse Width="9" Height="9" Fill="{Binding GameStatusKind, Converter={StaticResource Status}, ConverterParameter=dot}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mute}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding InMatch, Converter={StaticResource VisNot}}" Text="Works once you are in a match." />
                <TextBlock Text="{Binding GameStatus}" Foreground="{Binding GameStatusKind, Converter={StaticResource Status}}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.8*" MaxWidth="400" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="groupScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding LiveGroups}" Focusable="False" Margin="-6,-6,-6,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid VerticalAlignment="Top" Columns="{Binding ActualWidth, ElementName=groupScroll, Converter={StaticResource ColumnsFor}, ConverterParameter=300}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="6" VerticalAlignment="Stretch">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right" x:Name="badge" Style="{StaticResource Badge}" Background="{StaticResource InfoBg}">
                                            <TextBlock x:Name="badgeText" Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoFg}" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,0,6" HorizontalContentAlignment="Stretch" Padding="12,7" ToolTip="{Binding Tip}"
                                                        Command="{Binding DataContext.RunLiveActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="13" HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding Command}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Cheat}" Value="True">
                                    <Setter TargetName="badge" Property="Background" Value="{StaticResource AccentSoftBg}" />
                                    <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource AccentSoftFg}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LiveModeName}" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Bottom" />
                                <TextBlock Text="Live rule changes" Style="{StaticResource H2}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,10" Text="Lasts until the map changes. Empty = keep the current value." />
                            <ItemsControl ItemsSource="{Binding LiveRules}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="74" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Key}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextFaint}" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Default}" FontFamily="{StaticResource Mono}" Padding="6,4" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource MonoText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Current, StringFormat='now {0}'}" Visibility="{Binding Current, Converter={StaticResource Vis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Mute}" Visibility="{Binding LiveRules.Count, Converter={StaticResource VisNot}}"
                                       Text="The editable values appear here once a match is running." />
                            <CheckBox Content="Restart the round so every change applies" IsChecked="{Binding RestartAfterApply}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Read current values" Command="{Binding ReadLiveRulesCommand}" />
                                <Button Content="Apply now" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Command="{Binding ApplyLiveRulesCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Count bots" Style="{StaticResource GhostButton}" Padding="10,4" Command="{Binding CountBotsCommand}" />
                                <TextBlock Text="Console" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,10" Text="Any console command. Join several with |." />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Send" Margin="8,0,0,0" Command="{Binding SendCustomCommand}" />
                                <TextBox x:Name="commandBox" Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" Tag="e.g. SetRoundTimer 600"
                                         PreviewKeyDown="CommandBox_KeyDown" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding CommandSuggestions}" Margin="0,4,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,4" Margin="0,0,0,2" BorderThickness="0"
                                                Command="{Binding DataContext.UseGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Signature}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource TextMute}" Visibility="{Binding Note, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Content="Turn on cheats first (EnableCheats)" IsChecked="{Binding CheatsForCustom}" Margin="0,8,0,0" Foreground="{StaticResource TextDim}" />
                            <Border Style="{StaticResource Well}" Margin="0,10,0,0" Padding="10,8" MinHeight="70">
                                <TextBlock Text="{Binding LiveOutput}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mute}" VerticalAlignment="Bottom">
                                    <Run Text="{Binding GameCommandCount, Mode=OneWay}" /><Run Text=" found" />
                                </TextBlock>
                                <TextBlock Text="All game commands" Style="{StaticResource H2}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,8" Text="Click one to put it in the console box." />
                            <TextBox Text="{Binding CommandSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search commands" Margin="0,0,0,6" />
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding GameCommandsView}" ItemContainerStyle="{StaticResource PlainItem}" Height="340"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,0,1" BorderThickness="0" ToolTip="{Binding ParamText}"
                                                Command="{Binding DataContext.UseGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Signature}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource TextMute}" Visibility="{Binding Note, Converter={StaticResource Vis}}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
