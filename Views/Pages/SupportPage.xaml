<UserControl x:Class="SandstormModLauncher.Views.Pages.SupportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Support the project: a link to the maker's Ko-fi page and a few free ways to help. Nothing here connects anywhere by itself. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="20,18,20,20">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                <TextBlock Text="Made by one person, in spare time" Style="{StaticResource Kicker}" />
                <TextBlock Text="Support the project" Style="{StaticResource H1}" FontSize="20" Margin="0,2,0,14" />

                <Border Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource Accent}" Margin="0,0,14,0" />
                            <TextBlock Text="If this saved you time, you can say thanks" Style="{StaticResource H2}" FontSize="17" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,14,0,0" LineHeight="21"
                                   Text="This launcher is free, open source for non-commercial use, and has no ads, no accounts and no tracking. It is written and kept up to date by one player, after work. If it made your matches or your server easier, a coffee on Ko-fi helps keep the updates coming." />
                        <TextBlock Style="{StaticResource Mute}" Margin="0,10,0,0"
                                   Text="It is never required and nothing in the launcher is locked. Enjoy the game." />
                        <WrapPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource AccentButton}" Padding="18,8" Margin="0,0,10,6" Command="{Binding OpenKofiCommand}" ToolTip="Opens the Ko-fi page in your browser">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Support on Ko-fi" />
                                </StackPanel>
                            </Button>
                            <Button Content="Copy the link" Style="{StaticResource GhostButton}" Padding="14,8" Margin="0,0,10,6" Command="{Binding CopyKofiCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding SupportUrl}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="Other ways to help, free" Style="{StaticResource H2}" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Open GitHub" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Command="{Binding OpenGitHubCommand}" />
                            <StackPanel>
                                <TextBlock Text="Tell a friend, or star the project" FontSize="13.5" />
                                <TextBlock Text="The code and every release are on GitHub." Style="{StaticResource Mute}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,12" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Language settings" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                            <StackPanel>
                                <TextBlock Text="Translate it into your language" FontSize="13.5" />
                                <TextBlock Text="Save the translation file, fill it in, send it in. Nobody else has to do it for you." Style="{StaticResource Mute}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,12" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Report a problem" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                            <StackPanel>
                                <TextBlock Text="Found a bug? Say so" FontSize="13.5" />
                                <TextBlock Text="Settings > Something went wrong? shows you the whole report before anything is sent." Style="{StaticResource Mute}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
