<UserControl x:Class="SandstormModLauncher.Views.Pages.MutatorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Mute}" FontSize="13" VerticalAlignment="Center"
                       Text="Tick mutators to load them with the match, in order. Official ones are grouped by the playlists that use them." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Grid Width="260">
                    <TextBox Text="{Binding MutatorSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search name, ID, mod or description" Padding="30,6,8,6" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding RescanModsCommand}" ToolTip="Look for new or updated mods">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Rescan" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,14,0,12" LastChildFill="False">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Chip}" Content="All" IsChecked="{Binding MutatorFilter, Converter={StaticResource Eq}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MutatorFilter, Converter={StaticResource Eq}, ConverterParameter=Official}">
                    <TextBlock><Run Text="Official " /><Run Text="{Binding OfficialMutatorCount, Mode=OneWay}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MutatorFilter, Converter={StaticResource Eq}, ConverterParameter=Mods}">
                    <TextBlock><Run Text="From mods " /><Run Text="{Binding ModMutatorCount, Mode=OneWay}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MutatorFilter, Converter={StaticResource Eq}, ConverterParameter=Custom}"
                             Visibility="{Binding CustomMutatorCount, Converter={StaticResource Vis}}">
                    <TextBlock><Run Text="Added by name " /><Run Text="{Binding CustomMutatorCount, Mode=OneWay}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" IsChecked="{Binding MutatorFilter, Converter={StaticResource Eq}, ConverterParameter=Active}">
                    <TextBlock><Run Text="Active " /><Run Text="{Binding ActiveMutatorCount, Mode=OneWay}" /></TextBlock>
                </RadioButton>
            </StackPanel>
            <CheckBox DockPanel.Dock="Right" Content="Show base classes and helpers" IsChecked="{Binding ShowBaseClasses}" Foreground="{StaticResource TextDim}"
                      ToolTip="Some mods ship parent classes that other mutators build on. They normally do nothing on their own." />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <!-- list -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding MutatorsView}" SelectedItem="{Binding SelectedMutator}" Padding="10,4,10,10"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="6,14,6,6">
                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Bottom">
                                                <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" shown" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" FontFamily="{StaticResource Display}" FontSize="14" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" CornerRadius="8" Padding="12,10" Margin="0,0,0,4" BorderThickness="1" BorderBrush="Transparent" Background="{StaticResource Bg1}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                                    <Setter TargetName="b" Property="Background" Value="#1C1A15" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsActive}" VerticalAlignment="Top" Margin="0,2,12,0" ToolTip="Use this mutator" />
                                    <StackPanel Grid.Column="1">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource Bg4}" Margin="6,0,0,0" Visibility="{Binding IsBase, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="BASE CLASS" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource BadBg}" Margin="6,0,0,0" Visibility="{Binding NotRegistered, Converter={StaticResource Vis}}"
                                                        ToolTip="The mod does not register this folder for mutators, so the game may not find it.">
                                                    <TextBlock Text="NOT REGISTERED" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource BadFg}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource BadBg}" Margin="6,0,0,0" Visibility="{Binding Warning, Converter={StaticResource Vis}}" ToolTip="{Binding Warning}">
                                                    <TextBlock Text="CHECK" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource BadFg}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="ACTIVE" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftFg}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,1,0,0"
                                                   Visibility="{Binding ShowId, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Mute}" Margin="0,4,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- side -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Clear" Command="{Binding ClearMutatorsCommand}" VerticalAlignment="Bottom" />
                                <TextBlock Text="ACTIVE · LOAD ORDER" Style="{StaticResource H2}" FontSize="16" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding ActiveMutators}" Margin="0,10,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Index}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE70E;" ToolTip="Load earlier"
                                                            Command="{Binding DataContext.MoveMutatorUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE70D;" ToolTip="Load later"
                                                            Command="{Binding DataContext.MoveMutatorDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE711;" ToolTip="Remove"
                                                            Command="{Binding DataContext.RemoveMutatorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Mute}" Visibility="{Binding ActiveMutatorCount, Converter={StaticResource VisNot}}"
                                       Text="Tick mutators on the left to use them. Their order here is the load order." />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,6,0,0" Visibility="{Binding ActiveMutatorCount, Converter={StaticResource Vis}}"
                                       Text="Mutators load top to bottom. If a mod asks to load first or last, move it here." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="PRESETS" Style="{StaticResource H2}" FontSize="16" />
                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding MutatorPresetNames}" SelectedItem="{Binding SelectedMutatorPreset}" ToolTip="Load a saved set of mutators" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Save as new" Command="{Binding SaveMutatorPresetCommand}" />
                                <Button Content="Delete" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding DeleteMutatorPresetCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding SelectedMutator, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedMutator.Name, Converter={StaticResource Upper}}" Style="{StaticResource H2}" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,0">
                                <Run Text="From " /><Run Text="{Binding SelectedMutator.Group, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedMutator.Description}" Style="{StaticResource Dim}" FontSize="12.5" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding SelectedMutator.Warning}" Foreground="{StaticResource BadFg}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                       Visibility="{Binding SelectedMutator.Warning, Converter={StaticResource Vis}}" />

                            <TextBlock Text="MUTATOR ID" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="0,12,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedMutator.Id}" />
                                <Border Style="{StaticResource Well}" Padding="8,5">
                                    <TextBlock Text="{Binding SelectedMutator.Id}" FontFamily="{StaticResource Mono}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DockPanel>
                            <StackPanel Visibility="{Binding SelectedMutator.Info.ConfigSection, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                                <TextBlock Text="GAME.INI SECTION FOR ITS SETTINGS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMute}" Margin="0,10,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedMutator.Info.ConfigSection}" />
                                    <Border Style="{StaticResource Well}" Padding="8,5">
                                        <TextBlock Text="{Binding SelectedMutator.Info.ConfigSection}" FontFamily="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Open mod folder" Style="{StaticResource GhostButton}" Margin="0,0,8,6" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding SelectedMutatorMod.Folder}"
                                        Visibility="{Binding SelectedMutatorMod.Folder, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                                <Button Content="Remove this entry" Style="{StaticResource DangerButton}" Margin="0,0,8,6" Command="{Binding DeleteCustomMutatorCommand}" CommandParameter="{Binding SelectedMutator}"
                                        Visibility="{Binding SelectedMutator.SourceKey, Converter={StaticResource Vis}, ConverterParameter=Custom}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ADD BY NAME" Style="{StaticResource H2}" FontSize="16" />
                            <TextBlock Style="{StaticResource Mute}" Margin="0,2,0,8" Text="For a mutator the launcher can't see, type its ID exactly as the mod author gives it." />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Add" Margin="8,0,0,0" Command="{Binding AddCustomMutatorCommand}" />
                                <TextBox Text="{Binding CustomMutatorText, UpdateSourceTrigger=PropertyChanged}" Tag="MutatorID" FontFamily="{StaticResource Mono}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
