<UserControl x:Class="SandstormModLauncher.Views.Pages.PlaylistsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Mute}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="The game's own online playlists with their mutators, lighting and rulesets. Set one up, then tune the squad on the Map tab." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Grid Width="260">
                    <TextBox Text="{Binding PlaylistSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search playlists, mutators, features" Padding="30,6,8,6" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" IsHitTestVisible="False" />
                </Grid>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,12">
            <RadioButton Style="{StaticResource Chip}" Content="All" IsChecked="{Binding PlaylistFilter, Converter={StaticResource Eq}, ConverterParameter=All}" />
            <RadioButton Style="{StaticResource Chip}" Content="Co-op" IsChecked="{Binding PlaylistFilter, Converter={StaticResource Eq}, ConverterParameter=Coop}" />
            <RadioButton Style="{StaticResource Chip}" Content="Versus" IsChecked="{Binding PlaylistFilter, Converter={StaticResource Eq}, ConverterParameter=Versus}" />
        </StackPanel>

        <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding PlaylistsView}" ItemContainerStyle="{StaticResource PlainItem}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,6,10" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontSize="18" />
                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftFg}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource Bg4}" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Lighting}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource BadBg}" Margin="6,0,0,0" Visibility="{Binding Hardcore, Converter={StaticResource Vis}}">
                                        <TextBlock Text="HARDCORE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BadFg}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Mute}" Margin="0,3,0,0" Visibility="{Binding Description, Converter={StaticResource Vis}}" />
                                <TextBlock Style="{StaticResource Dim}" FontSize="12.5" Margin="0,6,0,0">
                                    <Run Text="Modes: " Foreground="{StaticResource TextMute}" /><Run Text="{Binding Modes, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Dim}" FontSize="12.5" Margin="0,2,0,0">
                                    <Run Text="Mutators: " Foreground="{StaticResource TextMute}" /><Run Text="{Binding MutatorText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding MissingText}" FontSize="12" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding HasMissing, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="Set up" Margin="0,0,8,0"
                                        Command="{Binding DataContext.SetupPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        ToolTip="Pick a fitting map and apply the playlist's mutators and rules, then go to Play to adjust bots" />
                                <Button Style="{StaticResource AccentButton}" Command="{Binding DataContext.PlayPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        ToolTip="Set it up and launch right away">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Play now" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
